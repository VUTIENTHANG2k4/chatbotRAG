# ────────── App ──────────
APP_NAME=Legal RAG API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ────────── LLM (default: local Ollama) ──────────
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# ────────── Embeddings (default: local HuggingFace) ──────────
EMBED_PROVIDER=huggingface
HF_EMBED_MODEL=keepitreal/vietnamese-sbert
HF_DEVICE=cpu

# ────────── Qdrant ──────────
QDRANT_COLLECTION=legal_documents

# ────────── Chunking ──────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ────────── Retrieval ──────────
TOP_K=5
RRF_K=60

# ────────── Upload ──────────
MAX_UPLOAD_SIZE_MB=50

# Optional cloud providers (uncomment if needed):
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
