# ────────── App ──────────
APP_NAME=Legal RAG API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Browser on Vercel calls the API directly. Leave empty for local-only.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ────────── LLM (default: local Ollama) ──────────
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Cloud mode: LLM_PROVIDER=gemini + GOOGLE_API_KEY (questions leave the machine)
GEMINI_MODEL=gemini-3.8-flash
# GOOGLE_API_KEY=AIza...

# ────────── Embeddings ──────────
# huggingface = local PyTorch (requirements.txt).
# hf-inference = same model via Hugging Face API (requirements-cloud.txt, no torch).
EMBED_PROVIDER=huggingface
HF_EMBED_MODEL=keepitreal/vietnamese-sbert
HF_DEVICE=cpu
# HF_TOKEN=hf_...

# ────────── Qdrant ──────────
QDRANT_COLLECTION=legal_documents
# Empty = file-based local Qdrant under storage/. Set both for Qdrant Cloud.
QDRANT_URL=
QDRANT_API_KEY=

# ────────── Deployment ──────────
# Production (Cloud Run): AUTO_INGEST=false, ENABLE_ADMIN_API=false
AUTO_INGEST=true
ENABLE_ADMIN_API=true

# ────────── Chunking ──────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ────────── Retrieval ──────────
TOP_K=5
RRF_K=60

# ────────── Upload ──────────
MAX_UPLOAD_SIZE_MB=50

# Optional:
# OPENAI_API_KEY=sk-...
